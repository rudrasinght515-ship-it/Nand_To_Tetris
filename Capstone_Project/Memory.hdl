CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:

    // Address decoding
    Not(in=address[14], out=notA14);
    Not(in=address[13], out=notA13);

    // RAM16K: addresses 0–16383
    And(a=load, b=notA14, out=loadRAM);

    RAM16K(
        in=in,
        load=loadRAM,
        address=address[0..13],
        out=ramOut
    );

    // Screen: addresses 16384–24575
    And(a=address[14], b=notA13, out=isScreen);
    And(a=load, b=isScreen, out=loadScreen);

    Screen(
        in=in,
        load=loadScreen,
        address=address[0..12],
        out=screenOut
    );

    // Keyboard: address 24576
    And(a=address[14], b=address[13], out=isKeyboard);

    Keyboard(out=keyboardOut);

    // Select output
    Mux16(a=ramOut, b=screenOut, sel=address[14], out=ramScreenOut);
    Mux16(a=ramScreenOut, b=keyboardOut, sel=isKeyboard, out=out);
}